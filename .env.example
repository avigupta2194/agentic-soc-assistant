# ============================================
# Agentic SOC Assistant - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys
# DO NOT commit .env to git!

# Google Gemini API (Free)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# VirusTotal API (Free - 4 req/min, 500/day)
# Sign up at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API (Free - 1000 checks/day)
# Sign up at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
